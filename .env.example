# Server & Port Configuration
PORT=3000
NODE_ENV=production

# Database Persistence (MongoDB Atlas URI)
# Provide your MongoDB Atlas connection string (e.g., mongodb+srv://username:password@cluster.mongodb.net/repurposeai)
# If left empty, the application safely falls back to local disk persistence in /data/db.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/repurposeai?retryWrites=true&w=majority
MONGODB_DB_NAME=repurposeai

# Authentication & Security
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters

# AI Content Generation & Analysis
# Google Gemini API key for structured transcript analysis, moment extraction, and multi-platform content generation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_MODEL=gemini-3.8-flash

# Media Audio Transcription
# Optional OpenAI Whisper API key for high-fidelity audio transcription of uploaded media files.
# If omitted, Gemini audio transcription or user-provided transcripts are utilized.
OPENAI_API_KEY=

# YouTube Data API (Optional)
# If provided, enables enhanced metadata and caption track resolution for YouTube links.
YOUTUBE_API_KEY=

# Frontend & CORS Configuration
# Allowed origin in production (e.g., https://your-domain.vercel.app)
CLIENT_URL=*

# Client API Base URL (leave empty for same-origin full-stack deployment)
VITE_API_BASE_URL=
